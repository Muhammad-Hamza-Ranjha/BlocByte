# Contact form delivery
# On Vercel, configure one of the options below and redeploy.
# If Resend is configured, submissions are emailed to CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ranjhah03@gmail.com
CONTACT_FROM_EMAIL=website@blocbytes.com

# Optional webhook delivery instead of email.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_BEARER_TOKEN=

# If neither delivery option is configured, submissions are only stored locally
# in development/self-hosted use via data/contact-submissions.ndjson.
