# Contact form delivery
# If Resend is configured, submissions are emailed to CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@blocbytes.com
CONTACT_FROM_EMAIL=website@blocbytes.com

# Optional webhook delivery instead of email.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_BEARER_TOKEN=

# If neither delivery option is configured, submissions are stored locally in
# data/contact-submissions.ndjson during development/self-hosted use.
